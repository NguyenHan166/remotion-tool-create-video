{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hansys.local/schemas/project-v1.json",
  "title": "HanSYS ProjectDocument v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "metadata",
    "composition",
    "template",
    "theme",
    "scenes",
    "audio",
    "captions",
    "export"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 5000
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "fps",
        "backgroundColor"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840
        },
        "height": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840
        },
        "fps": {
          "enum": [
            24,
            25,
            30,
            50,
            60
          ]
        },
        "backgroundColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primaryColor",
        "secondaryColor",
        "accentColor",
        "textColor",
        "mutedTextColor",
        "fontFamily"
      ],
      "properties": {
        "primaryColor": {
          "type": "string"
        },
        "secondaryColor": {
          "type": "string"
        },
        "accentColor": {
          "type": "string"
        },
        "textColor": {
          "type": "string"
        },
        "mutedTextColor": {
          "type": "string"
        },
        "fontFamily": {
          "enum": [
            "BeVietnamPro",
            "Inter",
            "NotoSans"
          ]
        },
        "logoAssetId": {
          "type": "string",
          "format": "uuid"
        },
        "watermarkText": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "voiceover": {
          "$ref": "#/$defs/audioTrack"
        },
        "backgroundMusic": {
          "$ref": "#/$defs/backgroundMusic"
        }
      }
    },
    "captions": {
      "$ref": "#/$defs/captions"
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset",
        "codec",
        "muted"
      ],
      "properties": {
        "preset": {
          "enum": [
            "draft",
            "vertical-h264",
            "vertical-high"
          ]
        },
        "codec": {
          "const": "h264"
        },
        "muted": {
          "type": "boolean"
        },
        "fileName": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  },
  "$defs": {
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "durationInFrames"
      ],
      "properties": {
        "type": {
          "enum": [
            "none",
            "fade",
            "slide-left",
            "slide-up"
          ]
        },
        "durationInFrames": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "fit",
        "positionX",
        "positionY",
        "scale",
        "startFromMs",
        "playbackRate",
        "muted"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "format": "uuid"
        },
        "fit": {
          "enum": [
            "cover",
            "contain"
          ]
        },
        "positionX": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "positionY": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scale": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 5
        },
        "startFromMs": {
          "type": "integer",
          "minimum": 0
        },
        "playbackRate": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4
        },
        "muted": {
          "type": "boolean"
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "enabled",
        "durationInFrames",
        "text",
        "style"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "enum": [
            "hook",
            "headline",
            "content",
            "image",
            "video",
            "bullet-list",
            "quote",
            "outro"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "enabled": {
          "type": "boolean"
        },
        "durationInFrames": {
          "type": "integer",
          "minimum": 6
        },
        "transition": {
          "$ref": "#/$defs/transition"
        },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 200
            },
            "headline": {
              "type": "string",
              "maxLength": 300
            },
            "body": {
              "type": "string",
              "maxLength": 5000
            },
            "source": {
              "type": "string",
              "maxLength": 500
            },
            "quoteAuthor": {
              "type": "string",
              "maxLength": 200
            },
            "bullets": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string",
                "maxLength": 240
              }
            }
          }
        },
        "media": {
          "$ref": "#/$defs/media"
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "textAlign",
            "emphasis"
          ],
          "properties": {
            "variant": {
              "type": "string",
              "maxLength": 100
            },
            "textAlign": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "emphasis": {
              "enum": [
                "normal",
                "strong",
                "urgent"
              ]
            }
          }
        }
      }
    },
    "audioTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "volume",
        "startAtFrame"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "format": "uuid"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "startAtFrame": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "backgroundMusic": {
      "allOf": [
        {
          "$ref": "#/$defs/audioTrack"
        },
        {
          "type": "object",
          "required": [
            "loop",
            "fadeInFrames",
            "fadeOutFrames"
          ],
          "properties": {
            "loop": {
              "type": "boolean"
            },
            "fadeInFrames": {
              "type": "integer",
              "minimum": 0
            },
            "fadeOutFrames": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "captionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "startMs",
        "endMs",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "startMs",
              "endMs"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "startMs": {
                "type": "integer",
                "minimum": 0
              },
              "endMs": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "source",
        "style",
        "entries",
        "options"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "source": {
          "enum": [
            "none",
            "manual",
            "srt"
          ]
        },
        "style": {
          "enum": [
            "clean",
            "tiktok",
            "news"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/captionEntry"
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxWordsPerPage",
            "highlightCurrentWord",
            "position",
            "fontSize"
          ],
          "properties": {
            "maxWordsPerPage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "highlightCurrentWord": {
              "type": "boolean"
            },
            "position": {
              "enum": [
                "top",
                "center",
                "bottom"
              ]
            },
            "fontSize": {
              "type": "number",
              "minimum": 12,
              "maximum": 200
            }
          }
        }
      }
    }
  }
}
