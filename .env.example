APP_IMAGE=your-dockerhub-user/hansys-video-studio
APP_VERSION=v0.1.0
APP_PORT=3000
APP_URL=http://localhost:3000

POSTGRES_DB=hansys_video
POSTGRES_USER=hansys
POSTGRES_PASSWORD=replace-with-a-strong-local-password

DATA_DIR=/data
MAX_UPLOAD_MB=1024
AUTO_SAVE_DELAY_MS=800

RENDER_JOB_CONCURRENCY=1
RENDER_FRAME_CONCURRENCY=50%
RENDER_JOB_POLL_MS=1000
RENDER_STALE_AFTER_MINUTES=30
RENDER_MAX_ATTEMPTS=2

LOG_LEVEL=info
