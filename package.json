{
  "name": "hansys-video-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first scene-based video creation and rendering tool",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:remotion-versions": "node scripts/check-remotion-versions.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint && eslint scripts tests e2e playwright.config.ts eslint.config.mjs prettier.config.mjs --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:video": "node scripts/video-frame-smoke.mjs",
    "test:video:breaking": "node scripts/breaking-red-frame-smoke.mjs",
    "test:video:warning": "node scripts/warning-dark-frame-smoke.mjs",
    "test:video:theme": "node scripts/theme-template-frame-smoke.mjs",
    "typecheck": "turbo run typecheck && tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
